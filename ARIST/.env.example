# IA: ollama (local) o cloud (API compatible con OpenAI)
ARIST_AI_PROVIDER=ollama
ARIST_OLLAMA_URL=http://localhost:11434
ARIST_MODEL=llama3.2
ARIST_OLLAMA_TIMEOUT=180
# Para proveedor cloud compatible con /chat/completions:
ARIST_CLOUD_BASE_URL=
ARIST_CLOUD_MODEL=
ARIST_CLOUD_API_KEY=

# Voz
ARIST_VOICE_LANGUAGE=es-MX
ARIST_WAKE_WORD=arist
# Ruta a carpeta del modelo español Vosk descargado y descomprimido
ARIST_VOSK_MODEL_PATH=

# Carpetas
ARIST_WORKSPACE=
ARIST_PRINT_FILES_DIR=
ARIST_DATA_DIR=
ARIST_BACKUP_DIR=

# Impresora: none, octoprint o moonraker
ARIST_PRINTER_BACKEND=none
ARIST_OCTOPRINT_URL=
ARIST_OCTOPRINT_API_KEY=
ARIST_MOONRAKER_URL=
ARIST_MOONRAKER_API_KEY=

# Laminador: none, curaengine o prusaslicer (integración pendiente de perfil)
ARIST_SLICER=none
ARIST_SLICER_PATH=
